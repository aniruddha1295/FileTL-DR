# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Private key for the testnet wallet (0x-prefixed hex). Use a dedicated throwaway
# testnet key only — never a mainnet key with real funds.
PRIVATE_KEY=0x...

# Public address, for reference/logging (matches PRIVATE_KEY's account)
WALLET_ADDRESS=0x044c40FBC017C74273eF402655391D4372Cf715e

# calibration = Filecoin testnet (default for this project)
FILECOIN_NETWORK=calibration
